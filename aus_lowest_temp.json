{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Lowest Temperature",
  "width": 320,
  "height": 260,
  "background": "#dae0eb",
  "projection": {"type": "conicEqualArea", "center": [134,-26], "parallels": [-18,-36]},
  "layer": [
    {
      "data": {"url":"maps/australia_map.json","format":{"type":"topojson","feature":"SA3_2016_AUST"}},
      "mark":{"type":"geoshape","fill":"white","stroke":"#888"}
    },
    {
      "data": {"url":"datasets/aus_lowest_temp.csv"},
      "mark":{"type":"circle"},
      "encoding":{
        "longitude":{"field":"Lon","type":"quantitative"},
        "latitude":{"field":"Lat","type":"quantitative"},
        "color":{
          "field":"Temperature","type":"quantitative",
          "scale":{"domain":[-23,1],"scheme":"blues"},
          "legend":{"title":"°C"}
        },
        "size":{"field":"Temperature","type":"quantitative","scale":{"domain":[-23,1],"range":[250,30]}},
        "tooltip":[
          {"field":"Place name","type":"nominal","title":"Place"},
          {"field":"Date","type":"ordinal"},
          {"field":"Temperature","type":"quantitative","title":"Lowest (°C)"}
        ]
      }
    }
  ],
  "config":{"legend":{"labelFont":"Times New Roman","labelFontSize":10,"labelColor":"black","orient":"right"}}
}
