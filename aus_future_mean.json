{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 500,
  "height": 300,
  "projection": {"type": "conicEqualArea", "center": [134,-26], "parallels": [-18,-36]},
  "layer": [
    {
      "data":{"url":"maps/australia_map.json","format":{"type":"topojson","feature":"SA3_2016_AUST"}},
      "mark":{"type":"geoshape","fill":"#f5f5f5","stroke":"white"}
    },
    {
      "data":{"url":"datasets/future_annual_mean.csv"},
      "mark":"circle",
      "encoding":{
        "longitude":{"field":"LON","type":"quantitative"},
        "latitude":{"field":"LAT","type":"quantitative"},
        "size":{"value":30},
        "color":{"field":"Mean","type":"quantitative","legend":{"title":"Future mean (°C)"}}
      }
    }
  ]
}
